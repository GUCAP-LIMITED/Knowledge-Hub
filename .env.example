# Copy to .env.local and fill in. All client-exposed vars MUST be prefixed with VITE_.
# These are validated at startup by src/core/config — a missing/invalid value fails fast.

# Base URL of the JSON API the app talks to (including the auth endpoints).
VITE_API_BASE_URL=https://api.example.com

# Logging verbosity: debug | info | warn | error | silent
VITE_LOG_LEVEL=info

# Optional: Sentry DSN for error reporting. Leave unset/empty to disable Sentry entirely.
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
