# Copy to .env.local and fill in. All client-exposed vars MUST be prefixed with VITE_.
# These are validated at startup by src/core/config — a missing/invalid value fails fast.

# API HOST ROOT (no /api suffix): e.g. http://localhost:5080 or https://academy-test-api.uapp.uk
# Feature gateways call absolute /api/app/... paths; the token endpoint is /connect/token off the root.
VITE_API_BASE_URL=http://localhost:5080

# ── SSO (Uapp Portal + OpenIddict) ──────────────────────────────────────────
# The login screen redirects here; the Portal authenticates the user and returns to the app with
# ?token=<secret>, which is exchanged at {VITE_API_BASE_URL}/connect/token (grant_type=SsoSecret).
# Test SSO: http://sso-test.uapp.uk   (production: the live Portal login URL)
VITE_PORTAL_LOGIN_URL=http://sso-test.uapp.uk
# Portal app key (identifies this app to the Portal); sent as the `key` query param.
VITE_PORTAL_KEY=
# OpenIddict client id + scope for the token exchange (defaults shown).
VITE_OAUTH_CLIENT_ID=UappAcademy_App
VITE_OAUTH_SCOPE=UappAcademy offline_access

# Logging verbosity: debug | info | warn | error | silent
VITE_LOG_LEVEL=info

# Optional: Sentry DSN for error reporting. Leave unset/empty to disable Sentry entirely.
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
